{
  "gateway": {
    "mode": "local",
    "port": 18789,
    "bind": "lan",
    "auth": {
      "mode": "token",
      "token": "${OPENCLAW_GATEWAY_TOKEN}"
    },
    "terminal": {
      "enabled": false
    },
    "controlUi": {
      "enabled": true
    }
  },
  "agents": {
    "defaults": {
      "workspace": "/home/node/.openclaw/workspace",
      "timeoutSeconds": 900,
      "utilityModel": "",
      "thinkingDefault": "max",
      "reasoningDefault": "off",
      "contextInjection": "continuation-skip",
      "bootstrapMaxChars": 4500,
      "bootstrapTotalMaxChars": 7500,
      "imageMaxDimensionPx": 768,
      "imageQuality": "efficient",
      "contextLimits": {
        "postCompactionMaxChars": 800
      },
      "contextPruning": {
        "mode": "cache-ttl",
        "ttl": "10m",
        "hardClear": {
          "enabled": true,
          "placeholder": "[旧工具结果已省略]"
        }
      },
      "model": {
        "primary": "codex-proxy/gpt-5.6-luna",
        "fallbacks": []
      },
      "imageModel": "codex-proxy/gpt-5.6-luna",
      "compaction": {
        "mode": "safeguard",
        "keepRecentTokens": 8000,
        "recentTurnsPreserve": 2,
        "postCompactionSections": [],
        "memoryFlush": {
          "enabled": false
        }
      }
    }
  },
  "session": {
    "resetByType": {
      "group": {
        "mode": "idle",
        "idleMinutes": 60
      }
    }
  },
  "models": {
    "mode": "replace",
    "providers": {
      "codex-proxy": {
        "baseUrl": "${CODEX_PROXY_BASE_URL}",
        "apiKey": {
          "source": "env",
          "provider": "default",
          "id": "CODEX_PROXY_TOKEN"
        },
        "api": "openai-completions",
        "timeoutSeconds": 900,
        "models": [
          {
            "id": "gpt-5.6-luna",
            "name": "GPT-5.6 Luna via Codex reverse proxy",
            "input": [
              "text",
              "image"
            ],
            "contextWindow": 262144,
            "maxTokens": 2048,
            "reasoning": true,
            "params": {
              "reasoning_effort": "max"
            },
            "compat": {
              "supportsTools": true,
              "supportsPromptCacheKey": true,
              "supportsReasoningEffort": true,
              "supportedReasoningEfforts": [
                "low",
                "medium",
                "high",
                "max"
              ],
              "reasoningEffortMap": {
                "low": "low",
                "medium": "medium",
                "high": "high",
                "max": "max"
              }
            }
          }
        ]
      }
    }
  },
  "plugins": {
    "enabled": true,
    "allow": [
      "openclaw-qqbot",
      "qq-diagnostic-filter",
      "duckduckgo"
    ],
    "entries": {
      "openclaw-qqbot": {
        "enabled": true
      },
      "qq-diagnostic-filter": {
        "enabled": true
      },
      "duckduckgo": {
        "enabled": true
      },
      "codex": {
        "enabled": false
      }
    },
    "load": {
      "paths": [
        "/opt/openclaw-local/qq-diagnostic-filter.mjs"
      ]
    }
  },
  "channels": {
    "qqbot": {
      "enabled": true,
      "appId": "${QQBOT_APP_ID}",
      "clientSecret": "${QQBOT_CLIENT_SECRET}",
      "dmPolicy": "open",
      "groupPolicy": "open",
      "allowFrom": ["openclaw:approval-disabled"],
      "groupAllowFrom": ["*"],
      "contextVisibility": "allowlist_quote",
      "historyLimit": 1,
      "groups": {
        "*": {
          "requireMention": true,
          "ignoreOtherMentions": true,
          "historyLimit": 1,
          "prompt": "每次艾特按独立话题处理，只看当前消息和明确引用；群内未艾特消息最多保留最近1条，不主动补全旧话题。明确引用若实际带图，优先使用那1张；没有引用时，仅当当前文字明确指向上图或刚才的图片才考虑最近1张，否则不带旧图。普通图片只给短反应，明确问画面时才分析。被艾特、回复机器人或私聊必须正常回应，不输出 NO_REPLY；后台巡检无事才可输出 NO_REPLY。政治或高风险问题用俏皮打岔，不复述、解释或搜索。provider、模型、API、限流、配额、工具和堆栈细节只留日志，不发 QQ。",
          "toolPolicy": "restricted"
        }
      }
    }
  },
  "tools": {
    "deny": [
      "exec",
      "read",
      "write"
    ],
    "web": {
      "search": {
        "enabled": true,
        "provider": "duckduckgo"
      }
    },
    "media": {
      "models": [
        {
          "provider": "codex-proxy",
          "model": "gpt-5.6-luna",
          "capabilities": [
            "image"
          ],
          "timeoutSeconds": 180,
          "maxChars": 1200
        }
      ],
      "image": {
        "enabled": true,
        "attachments": {
          "mode": "first",
          "maxAttachments": 1
        },
        "timeoutSeconds": 180,
        "maxChars": 1200
      },
      "video": {
        "enabled": false
      }
    }
  },
  "messages": {
    "suppressToolErrors": true,
    "inbound": {
      "debounceMs": 700
    },
    "queue": {
      "mode": "steer",
      "cap": 2,
      "drop": "old"
    }
  }
}
