{
  "gateway": {
    "mode": "local",
    "port": 18789,
    "bind": "lan",
    "auth": {
      "mode": "token",
      "token": "${OPENCLAW_GATEWAY_TOKEN}"
    },
    "terminal": {
      "enabled": false
    },
    "controlUi": {
      "enabled": true
    }
  },
  "agents": {
    "defaults": {
      "workspace": "/home/node/.openclaw/workspace",
      "contextTokens": 32768,
      "timeoutSeconds": 900,
      "utilityModel": "",
      "thinkingDefault": "medium",
      "contextInjection": "continuation-skip",
      "bootstrapMaxChars": 4500,
      "bootstrapTotalMaxChars": 7500,
      "bootstrapPromptTruncationWarning": "off",
      "imageMaxDimensionPx": 768,
      "imageQuality": "efficient",
      "contextLimits": {
        "postCompactionMaxChars": 800,
        "toolResultMaxChars": 6000
      },
      "contextPruning": {
        "mode": "cache-ttl",
        "ttl": "10m",
        "keepLastAssistants": 2,
        "softTrimRatio": 0.25,
        "hardClearRatio": 0.45,
        "minPrunableToolChars": 800,
        "softTrim": {
          "maxChars": 1200,
          "headChars": 400,
          "tailChars": 400
        },
        "hardClear": {
          "enabled": true,
          "placeholder": "[旧工具结果已省略]"
        }
      },
      "model": {
        "primary": "deepseek/deepseek-v4-flash",
        "fallbacks": []
      },
      "imageModel": "sensenova-vision/sensenova-6.7-flash-lite",
      "compaction": {
        "mode": "safeguard",
        "keepRecentTokens": 8000,
        "recentTurnsPreserve": 2,
        "maxHistoryShare": 0.4,
        "truncateAfterCompaction": true,
        "postCompactionSections": [],
        "memoryFlush": {
          "enabled": false
        }
      }
    }
  },
  "session": {
    "resetByType": {
      "group": {
        "mode": "idle",
        "idleMinutes": 60
      }
    }
  },
  "models": {
    "mode": "merge",
    "providers": {
      "deepseek": {
        "baseUrl": "https://api.deepseek.com/v1",
        "apiKey": {
          "source": "env",
          "provider": "default",
          "id": "DEEPSEEK_API_KEY"
        },
        "api": "openai-completions",
        "models": [
          {
            "id": "deepseek-v4-flash",
            "name": "Official DeepSeek V4 Flash (Mac text generation)",
            "input": [
              "text"
            ],
            "contextWindow": 131072,
            "maxTokens": 2048,
            "reasoning": true
          }
        ]
      },
      "sensenova-vision": {
        "baseUrl": "https://token.sensenova.cn/v1",
        "apiKey": {
          "source": "env",
          "provider": "default",
          "id": "SENSENOVA_API_KEY"
        },
        "api": "openai-completions",
        "models": [
          {
            "id": "sensenova-6.7-flash-lite",
            "name": "SenseNova 6.7 Flash-Lite (Mac image understanding)",
            "input": [
              "text",
              "image"
            ],
            "contextWindow": 131072,
            "maxTokens": 800,
            "compat": {
              "supportsTools": false
            }
          }
        ]
      }
    }
  },
  "plugins": {
    "enabled": true,
    "bundledDiscovery": "allowlist",
    "allow": [
      "qqbot",
      "qq-diagnostic-filter",
      "duckduckgo"
    ],
    "entries": {
      "qqbot": {
        "enabled": true
      },
      "qq-diagnostic-filter": {
        "enabled": true
      },
      "duckduckgo": {
        "enabled": true
      },
      "codex": {
        "enabled": false
      }
    },
    "load": {
      "paths": [
        "/opt/openclaw-local/qq-diagnostic-filter.mjs"
      ]
    }
  },
  "channels": {
    "qqbot": {
      "enabled": true,
      "appId": "${QQBOT_APP_ID}",
      "clientSecret": "${QQBOT_CLIENT_SECRET}",
      "dmPolicy": "open",
      "groupPolicy": "open",
      "allowFrom": ["*"],
      "groupAllowFrom": ["*"],
      "contextVisibility": "allowlist_quote",
      "historyLimit": 1,
      "groups": {
        "*": {
          "requireMention": true,
          "ignoreOtherMentions": true,
          "historyLimit": 1,
          "commandLevel": "safety",
          "prompt": "每次艾特按独立话题处理，只看当前消息和明确引用；群内未艾特消息最多保留最近1条，不主动补全旧话题。明确引用若实际带图，优先使用那1张；没有引用时，仅当当前文字明确指向上图或刚才的图片才考虑最近1张，否则不带旧图。普通图片只给短反应，明确问画面时才分析。被艾特、回复机器人或私聊必须正常回应，不输出 NO_REPLY；后台巡检无事才可输出 NO_REPLY。政治或高风险问题用俏皮打岔，不复述、解释或搜索。provider、模型、API、限流、配额、工具和堆栈细节只留日志，不发 QQ。",
          "tools": {
            "deny": [
              "exec",
              "read",
              "write"
            ]
          }
        }
      }
    }
  },
  "tools": {
    "deny": [
      "exec",
      "read",
      "write"
    ],
    "web": {
      "search": {
        "enabled": true,
        "provider": "duckduckgo"
      }
    },
    "media": {
      "models": [
        {
          "provider": "sensenova-vision",
          "model": "sensenova-6.7-flash-lite",
          "capabilities": [
            "image"
          ],
          "timeoutSeconds": 180,
          "maxChars": 400
        }
      ],
      "video": {
        "enabled": false
      }
    }
  },
  "messages": {
    "suppressToolErrors": true,
    "inbound": {
      "debounceMs": 700
    },
    "queue": {
      "mode": "steer",
      "debounceMs": 700,
      "cap": 2,
      "drop": "old"
    }
  }
}
