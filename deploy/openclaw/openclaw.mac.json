{
  "gateway": {
    "mode": "local",
    "port": 18789,
    "bind": "lan",
    "auth": {
      "mode": "token",
      "token": "${OPENCLAW_GATEWAY_TOKEN}"
    },
    "terminal": {
      "enabled": false
    },
    "controlUi": {
      "enabled": true
    }
  },
  "agents": {
    "defaults": {
      "workspace": "/home/node/.openclaw/workspace",
      "contextTokens": 131072,
      "timeoutSeconds": 900,
      "utilityModel": "",
      "model": {
        "primary": "sensenova-token/deepseek-v4-flash",
        "fallbacks": [
          "deepseek/deepseek-chat"
        ]
      },
      "imageModel": "sensenova-vision/sensenova-6.7-flash-lite",
      "compaction": {
        "mode": "safeguard",
        "keepRecentTokens": 20000,
        "recentTurnsPreserve": 8
      }
    }
  },
  "session": {
    "resetByType": {
      "group": {
        "mode": "idle",
        "idleMinutes": 120
      }
    }
  },
  "models": {
    "mode": "merge",
    "providers": {
      "deepseek": {
        "baseUrl": "https://api.deepseek.com/v1",
        "apiKey": {
          "source": "env",
          "provider": "default",
          "id": "DEEPSEEK_API_KEY"
        },
        "api": "openai-completions",
        "models": [
          {
            "id": "deepseek-chat",
            "name": "Official DeepSeek Chat (Mac text fallback)",
            "input": [
              "text"
            ],
            "contextWindow": 131072,
            "maxTokens": 2048
          }
        ]
      },
      "sensenova-token": {
        "baseUrl": "https://token.sensenova.cn/v1",
        "apiKey": {
          "source": "env",
          "provider": "default",
          "id": "SENSENOVA_API_KEY"
        },
        "api": "openai-completions",
        "models": [
          {
            "id": "deepseek-v4-flash",
            "name": "SenseNova DeepSeek V4 Flash (Mac text primary)",
            "input": [
              "text"
            ],
            "contextWindow": 1048576,
            "maxTokens": 2048
          }
        ]
      },
      "sensenova-vision": {
        "baseUrl": "https://token.sensenova.cn/v1",
        "apiKey": {
          "source": "env",
          "provider": "default",
          "id": "SENSENOVA_API_KEY"
        },
        "api": "openai-completions",
        "models": [
          {
            "id": "sensenova-6.7-flash-lite",
            "name": "SenseNova 6.7 Flash-Lite (Mac image understanding)",
            "input": [
              "text",
              "image"
            ],
            "contextWindow": 131072,
            "maxTokens": 800,
            "compat": {
              "supportsTools": false
            }
          }
        ]
      }
    }
  },
  "plugins": {
    "enabled": true,
    "bundledDiscovery": "allowlist",
    "allow": [
      "qqbot",
      "qq-diagnostic-filter",
      "duckduckgo"
    ],
    "entries": {
      "qqbot": {
        "enabled": true
      },
      "qq-diagnostic-filter": {
        "enabled": true
      },
      "duckduckgo": {
        "enabled": true
      },
      "codex": {
        "enabled": false
      }
    },
    "load": {
      "paths": [
        "/opt/openclaw-local/qq-diagnostic-filter.mjs"
      ]
    }
  },
  "channels": {
    "qqbot": {
      "enabled": true,
      "appId": "${QQBOT_APP_ID}",
      "clientSecret": "${QQBOT_CLIENT_SECRET}",
      "dmPolicy": "open",
      "groupPolicy": "open",
      "allowFrom": ["*"],
      "groupAllowFrom": ["*"],
      "contextVisibility": "all",
      "historyLimit": 32,
      "groups": {
        "*": {
          "requireMention": true,
          "ignoreOtherMentions": false,
          "historyLimit": 32,
          "commandLevel": "safety",
          "prompt": "群聊上下文策略：普通群消息即使没有艾特，也要作为待处理上下文持续采集和保留；只有被艾特、回复机器人、私聊，或主动巡检才调用模型。每条新的艾特消息默认视为新话题，只使用当前消息和明确引用的内容，不得因为上一条消息有图片就自动附加上一张图片。表情包、梗图和普通图片默认只给一句短点评或反应，不要复述画面、OCR或写图片说明；只有当前消息明确询问图片内容时才进行视觉分析。被艾特、回复机器人或私聊时，除非触发 AGENTS.md 的禁止规则或其他安全规则，必须正常回答，不得输出 NO_REPLY；只有主动巡检任务在判断没有必要发言时才允许只输出 NO_REPLY。主动巡检时先通读最近群消息，判断是否有需要补充、承接、纠错或活跃气氛的内容；不要为了刷存在感重复别人已经说过的内容。每次主动发言最多拆成 1 到 3 条短消息，优先一条解决。涉及 QQ 小程序时，先提取标题并搜索该标题，再根据搜索结果解读；搜不到时明确说明。古代政治相关问题按 AGENTS.md 的禁止规则处理。Internal error policy: never send provider, model, API, HTTP, 429, quota, rate-limit, busy, safety, tool, trace, stack, or fallback diagnostics to QQ. If a route fails, use a successful fallback answer；if every route fails, send no diagnostic text.",
          "tools": {
            "deny": [
              "exec",
              "read",
              "write"
            ]
          }
        }
      }
    }
  },
  "tools": {
    "deny": [
      "exec",
      "read",
      "write"
    ],
    "web": {
      "search": {
        "enabled": true,
        "provider": "duckduckgo"
      }
    },
    "media": {
      "models": [
        {
          "provider": "sensenova-vision",
          "model": "sensenova-6.7-flash-lite",
          "capabilities": [
            "image"
          ],
          "timeoutSeconds": 180,
          "maxChars": 800
        }
      ],
      "video": {
        "enabled": false
      }
    }
  },
  "messages": {
    "suppressToolErrors": true,
    "inbound": {
      "debounceMs": 2500
    },
    "queue": {
      "mode": "collect",
      "debounceMs": 2500,
      "cap": 32,
      "drop": "summarize"
    }
  }
}
