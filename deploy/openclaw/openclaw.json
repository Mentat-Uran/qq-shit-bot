{
  "gateway": {
    "mode": "local",
    "port": 18789,
    "bind": "lan",
    "auth": {
      "mode": "token",
      "token": "${OPENCLAW_GATEWAY_TOKEN}"
    },
    "terminal": {
      "enabled": false
    },
    "controlUi": {
      "enabled": true
    }
  },
  "agents": {
    "defaults": {
      "workspace": "/home/node/.openclaw/workspace",
      "contextTokens": 65536,
      "timeoutSeconds": 300,
      "utilityModel": "",
      "model": {
        "primary": "sensenova-token/deepseek-v4-flash",
        "fallbacks": [
          "hermes-deepseek/deepseek-chat"
        ]
      },
      "imageModel": "local-vision/qwen2.5vl:7b",
      "compaction": {
        "mode": "safeguard",
        "keepRecentTokens": 16000,
        "recentTurnsPreserve": 8
      }
    }
  },
  "models": {
    "mode": "merge",
    "providers": {
      "sensenova-token": {
        "baseUrl": "https://token.sensenova.cn/v1",
        "apiKey": {
          "source": "env",
          "provider": "default",
          "id": "SENSENOVA_API_KEY"
        },
        "api": "openai-completions",
        "models": [
          {
            "id": "deepseek-v4-flash",
            "name": "SenseNova DeepSeek V4 Flash",
            "input": [
              "text"
            ],
            "contextWindow": 1048576,
            "maxTokens": 8192
          }
        ]
      },
      "hermes-deepseek": {
        "baseUrl": "https://api.deepseek.com/v1",
        "apiKey": {
          "source": "env",
          "provider": "default",
          "id": "HERMES_DEEPSEEK_API_KEY"
        },
        "api": "openai-completions",
        "models": [
          {
            "id": "deepseek-chat",
            "name": "Official DeepSeek Chat",
            "input": [
              "text"
            ],
            "contextWindow": 131072,
            "maxTokens": 8192
          }
        ]
      },
      "local-vision": {
        "baseUrl": "http://host.docker.internal:8010/v1",
        "apiKey": "local",
        "api": "openai-completions",
        "models": [
          {
            "id": "qwen2.5vl:7b",
            "name": "Local Qwen2.5-VL 7B",
            "input": [
              "text",
              "image"
            ],
            "contextWindow": 32768,
            "maxTokens": 4096,
            "compat": {
              "supportsTools": false
            }
          }
        ]
      }
    }
  },
  "plugins": {
    "enabled": true,
    "bundledDiscovery": "allowlist",
    "allow": [
      "qqbot"
    ],
    "entries": {
      "qqbot": {
        "enabled": true
      }
    }
  },
  "channels": {
    "qqbot": {
      "enabled": true,
      "appId": "${QQBOT_APP_ID}",
      "clientSecret": {
        "source": "env",
        "provider": "default",
        "id": "QQBOT_CLIENT_SECRET"
      },
      "dmPolicy": "allowlist",
      "allowFrom": [
        "${QQBOT_ALLOWED_USER_OPENID}"
      ],
      "groupPolicy": "allowlist",
      "groupAllowFrom": [
        "${QQBOT_ALLOWED_MEMBER_OPENID}"
      ],
      "contextVisibility": "all",
      "historyLimit": 50,
      "groups": {
        "*": {
          "requireMention": true,
          "ignoreOtherMentions": false,
          "historyLimit": 50,
          "commandLevel": "safety",
          "prompt": "群聊上下文策略：普通群消息即使没有艾特，也要作为待处理上下文持续采集和保留；只有被艾特、回复机器人、私聊，或主动巡检才调用模型。被艾特、回复机器人或私聊时，除非触发 AGENTS.md 的禁止规则或其他安全规则，必须正常回答，不得输出 NO_REPLY；只有主动巡检任务在判断没有必要发言时才允许只输出 NO_REPLY。主动巡检时先通读最近群消息，判断是否有需要补充、承接、纠错或活跃气氛的内容；不要为了刷存在感重复别人已经说过的内容。每次主动发言最多拆成 1 到 3 条短消息，优先一条解决。涉及 QQ 小程序时，先提取标题并搜索该标题，再根据搜索结果解读；搜不到时明确说明。古代政治相关问题按 AGENTS.md 的禁止规则处理。",
          "tools": {
            "deny": [
              "exec",
              "read",
              "write"
            ]
          }
        }
      }
    }
  },
  "tools": {
    "deny": [
      "exec",
      "read",
      "write"
    ],
    "media": {
      "models": [
        {
          "type": "cli",
          "command": "node",
          "args": [
            "/opt/openclaw-local/nvidia-image-cli.mjs",
            "--media-path",
            "{{MediaPath}}",
            "--prompt",
            "{{Prompt}}",
            "--max-chars",
            "{{MaxChars}}"
          ],
          "capabilities": [
            "image"
          ],
          "timeoutSeconds": 600,
          "maxBytes": 20971520,
          "maxChars": 2000
        },
        {
          "provider": "local-vision",
          "model": "qwen2.5vl:7b",
          "capabilities": [
            "image"
          ],
          "timeoutSeconds": 180,
          "maxChars": 2000
        }
      ],
      "video": {
        "enabled": true,
        "maxBytes": 52428800,
        "timeoutSeconds": 1200,
        "maxChars": 6000,
        "prompt": "请读取这个视频，概括主要场景、人物、动作、文字和事件发生顺序；看不清或无法确定的内容请明确说明。",
        "models": [
          {
            "type": "cli",
            "command": "node",
            "args": [
              "/opt/openclaw-local/mage-video-cli.mjs",
              "--media-path",
              "{{MediaPath}}",
              "--prompt",
              "{{Prompt}}",
              "--max-chars",
              "{{MaxChars}}"
            ],
            "capabilities": [
              "video"
            ],
            "timeoutSeconds": 1200,
            "maxBytes": 52428800,
            "maxChars": 6000
          }
        ]
      }
    }
  },
  "messages": {
    "inbound": {
      "debounceMs": 2500
    },
    "queue": {
      "mode": "collect",
      "debounceMs": 2500,
      "cap": 50,
      "drop": "summarize"
    }
  }
}
