# OpenClaw and the official QQ/DDG plugins are pinned to verified stable
# releases; the core and plugin tracks use their own version numbers.
# The required names and supported legacy aliases are defined in environment-contract.txt.
OPENCLAW_IMAGE=ghcr.io/openclaw/openclaw:2026.8.2
OPENCLAW_QQBOT_PLUGIN=@tencent-connect/openclaw-qqbot@2.0.3

# The Control UI is published on host loopback only.
OPENCLAW_GATEWAY_PORT=18789
OPENCLAW_GATEWAY_TOKEN=replace-with-a-random-token
OPENCLAW_TZ=Asia/Shanghai

# Optional host-console controls: keep both services on loopback by default. To make the Mac
# reachable from a trusted LAN, bind to a concrete Mac LAN address. The helper
# can use OPS_CONSOLE_AUTH_MODE=none for redacted read-only LAN access; never
# use that mode with 0.0.0.0 or public port forwarding.
OPENCLAW_GATEWAY_BIND_HOST=127.0.0.1
OPENCLAW_GATEWAY_PUBLIC_HOST=127.0.0.1
OPS_CONSOLE_BIND_HOST=127.0.0.1
OPS_CONSOLE_PORT=18888
OPS_CONSOLE_AUTH_MODE=token
OPS_CONSOLE_TOKEN=replace-with-ops-console-token

# setup.sh replaces these with the current host UID/GID on Unix-like systems.
OPENCLAW_UID=1000
OPENCLAW_GID=1000

# QQ Open Platform credentials are filled by scripts/windows/Bind-OpenClawQQBot.bat
# through the one-time QR flow. DM and group mention access are open by default,
# so the allowlist OpenIDs and the proactive review home channel are optional.
QQBOT_APP_ID=replace-with-qq-app-id
QQBOT_CLIENT_SECRET=replace-with-qq-app-secret
QQBOT_ALLOWED_USER_OPENID=
QQBOT_ALLOWED_MEMBER_OPENID=
# Optional: keep false unless a low-frequency background group review is intentional.
QQBOT_PROACTIVE_REVIEW_ENABLED=false
QQBOT_HOME_CHANNEL=

# Use the same OpenAI-compatible Codex reverse proxy for text and image
# understanding on every operating system. Docker Desktop resolves
# host.docker.internal to the host; the Linux Codex overlay may instead use
# http://127.0.0.1:18317/v1 with host networking.
CODEX_PROXY_BASE_URL=http://host.docker.internal:18317/v1
CODEX_PROXY_TOKEN=replace-with-codex-proxy-token

# Linux Codex overlay ASR defaults for an 8 GiB GPU.  Lower max-model-len or
# tune utilization only when deploying on hardware with a different VRAM size.
QWEN_ASR_GPU_MEMORY_UTILIZATION=0.75
QWEN_ASR_MAX_MODEL_LEN=2048

# Linux Codex overlay: the CPU-only game sidecar receives the same Codex proxy
# URL and token from CODEX_PROXY_BASE_URL/CODEX_PROXY_TOKEN in Compose. Keep
# reasoning at max ("LunaMax") without creating a second credential.
GAME_LLM_MODEL=gpt-5.6-luna
GAME_LLM_REASONING_EFFORT=max
GAME_AI_GENERATION_TIMEOUT=45
GAME_LLM_GENERATE_MAX_TOKENS=256
GAME_LLM_JUDGE_MAX_TOKENS=256
# local starts immediately from the 50-puzzle catalog; use ai to enable
# bounded DuckDuckGo reference search plus LunaMax puzzle generation.
GAME_PUZZLE_SOURCE=local
# Keep local-puzzle rotation across qqbot-game/container restarts.
GAME_PUZZLE_SELECTION_STATE_PATH=/var/lib/qq-game/selection.json
# Keep an independent bounded rotation for each QQ group/conversation.
GAME_PUZZLE_SELECTION_MAX_GROUPS=2048
# Text-first games: no model call is needed for either game.  Each group or
# private conversation has at most one active game; active rounds live in RAM.
GAME_CHAT_CHAIN_MAX_ROUNDS=30
GAME_CHAT_WORDLE_MAX_GUESSES=10
GAME_CHAT_MAX_SESSIONS=2048
GAME_WEB_SEARCH_ENABLED=true
GAME_WEB_SEARCH_URL=https://html.duckduckgo.com/html/
QQBOT_GAME_SERVICE_URL=http://127.0.0.1:18104
QQBOT_GAME_CPUS=1.0
QQBOT_GAME_MEMORY_LIMIT=768m

# Optional ordinary-QQ bridge: NapCatQQ connects as an OneBot 11 reverse
# WebSocket client. Keep this token separate from the Gateway and Codex
# tokens. The launcher refuses to start the bridge until the three boundary
# values below are configured with real local values.
ONEBOT_ACCESS_TOKEN=replace-with-onebot-access-token
ONEBOT_SELF_ID=
ONEBOT_WS_HOST=0.0.0.0
# Host-network Linux overlay override; keep the reverse WS loopback-only unless
# a concrete trusted LAN endpoint has been reviewed separately.
ONEBOT_CODEX_WS_HOST=127.0.0.1
ONEBOT_CODEX_GATEWAY_URL=http://127.0.0.1:18789
ONEBOT_CODEX_GAME_SERVICE_URL=http://127.0.0.1:18104
ONEBOT_CODEX_ASR_URL=http://127.0.0.1:18102/v1
ONEBOT_CODEX_TTS_URL=http://127.0.0.1:18102/v1
ONEBOT_WS_PORT=16700
ONEBOT_WS_PATH=/onebot/v11/ws
# Use the exact group numbers that may reach this account. Do not use * unless
# ONEBOT_ALLOW_ALL_GROUPS=true is an intentional, reviewed choice.
ONEBOT_ALLOWED_GROUP_IDS=replace-with-group-id
ONEBOT_ALLOWED_USER_IDS=
ONEBOT_ADMIN_USER_IDS=replace-with-admin-qq
ONEBOT_ALLOW_ALL_GROUPS=false
ONEBOT_DM_POLICY=allowlist
# Strict mode: every group message must explicitly @ this account, including
# commands, replies, and game inputs. Turn this off only if those exceptions
# are intentionally wanted.
ONEBOT_GROUP_REQUIRE_MENTION=true
ONEBOT_STRICT_GROUP_MENTION=true
ONEBOT_COMMANDS_BYPASS_MENTION=true
# The adapter sends a synthetic "qqbot" channel context so the existing
# runtime persona, safety rules, image policy, and bounded-history prompt are
# reused. It does not use the official QQ transport to deliver the response.
ONEBOT_GATEWAY_URL=http://openclaw-gateway:18789
ONEBOT_GATEWAY_MODEL=openclaw/default
ONEBOT_GATEWAY_MESSAGE_CHANNEL=qqbot
ONEBOT_GATEWAY_TIMEOUT_MS=900000
ONEBOT_INBOUND_DEBOUNCE_MS=700
ONEBOT_QUEUE_CAP=2
ONEBOT_GAME_SERVICE_URL=http://qqbot-game:18104
ONEBOT_ASR_URL=
ONEBOT_ASR_MODEL=Qwen/Qwen3-ASR-1.7B
ONEBOT_TTS_URL=
ONEBOT_TTS_MODEL=Qwen3-TTS-12Hz-1.7B-Base
ONEBOT_TTS_VOICE=serena
ONEBOT_AUTO_VOICE_REPLY=true
ONEBOT_AUDIO_MAX_BYTES=33554432
# Empty keeps the built-in official QQ signed-media host; add exact NapCat
# media hostnames here if this account returns a different QQ CDN host.
ONEBOT_IMAGE_ALLOWED_HOSTS=
ONEBOT_IMAGE_MAX_BYTES=20971520
ONEBOT_REPLY_TO_MESSAGE=true
ONEBOT_TEXT_CHUNK_SIZE=3500
ONEBOT_MEDIA_ROOTS=/home/node/.openclaw/workspace,/tmp/openclaw

# Optional NapCat-Docker service. Login/QR and the WebSocket client are set in
# NapCat's WebUI; no QQ session data belongs in this file or in Git.
NAPCAT_IMAGE=mlikiowa/napcat-docker:latest
NAPCAT_UID=1000
NAPCAT_GID=1000
NAPCAT_WEBUI_PORT=6099
