# OpenClaw and its official QQ plugin are pinned to the same stable release.
OPENCLAW_IMAGE=ghcr.io/openclaw/openclaw:2026.7.1
OPENCLAW_QQBOT_PLUGIN=@openclaw/qqbot@2026.7.1

# The Control UI is published on host loopback only.
OPENCLAW_GATEWAY_PORT=18789
OPENCLAW_GATEWAY_TOKEN=replace-with-a-random-token
OPENCLAW_TZ=Asia/Shanghai

# setup.sh replaces these with the current host UID/GID on Unix-like systems.
OPENCLAW_UID=1000
OPENCLAW_GID=1000

# QQ Open Platform credentials and the owner identifiers allowed to invoke the bot.
QQBOT_APP_ID=replace-with-qq-app-id
QQBOT_CLIENT_SECRET=replace-with-qq-app-secret
QQBOT_ALLOWED_USER_OPENID=replace-with-dm-user-openid
QQBOT_ALLOWED_MEMBER_OPENID=replace-with-group-member-openid

# Keep the repository's default provider and fallback model available to OpenClaw.
SENSENOVA_API_KEY=replace-with-sensenova-api-key
HERMES_DEEPSEEK_API_KEY=replace-with-deepseek-api-key
