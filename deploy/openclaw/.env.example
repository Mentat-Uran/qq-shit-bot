# OpenClaw and its official QQ plugin are pinned to the same stable release.
OPENCLAW_IMAGE=ghcr.io/openclaw/openclaw:2026.7.1
OPENCLAW_QQBOT_PLUGIN=@openclaw/qqbot@2026.7.1

# The Control UI is published on host loopback only.
OPENCLAW_GATEWAY_PORT=18789
OPENCLAW_GATEWAY_TOKEN=replace-with-a-random-token
OPENCLAW_TZ=Asia/Shanghai

# setup.sh replaces these with the current host UID/GID on Unix-like systems.
OPENCLAW_UID=1000
OPENCLAW_GID=1000

# QQ Open Platform credentials and the owner identifiers allowed to invoke the bot.
QQBOT_APP_ID=replace-with-qq-app-id
QQBOT_CLIENT_SECRET=replace-with-qq-app-secret
QQBOT_ALLOWED_USER_OPENID=replace-with-dm-user-openid
QQBOT_ALLOWED_MEMBER_OPENID=replace-with-group-member-openid

# Use the same no-key DuckDuckGo search route that Hermes auto-detects locally.
SENSENOVA_API_KEY=replace-with-sensenova-api-key
# The official DeepSeek fallback is loaded from Hermes DPAPI by the Windows
# launcher; do not paste that key into this file or commit it.

# Local Microsoft Mage-VL video understanding stack. RETIRED: the container is
# no longer built or started and openclaw.json has no video route. Variables
# are kept only for the retained reference compose overlay.
MAGE_VIDEO_BASE_IMAGE=vllm/vllm-openai:v0.26.0
MAGE_MODEL_ID=microsoft/Mage-VL
MAGE_VIDEO_PORT=30000
MAGE_VIDEO_NUM_FRAMES=8
MAGE_MAX_UPLOAD_BYTES=209715200
MAGE_MAX_COMPRESSED_BYTES=104857600
MAGE_VIDEO_COMPRESS_WIDTH=960
MAGE_VIDEO_COMPRESS_FPS=24
MAGE_VIDEO_COMPRESS_CRF=30
MAGE_VIDEO_COMPRESS_TIMEOUT_SECONDS=300
MAGE_MAX_NEW_TOKENS=384
MAGE_VIDEO_SEGMENT_SECONDS=60
MAGE_VIDEO_MAX_SEGMENTS=8
MAGE_MODEL_DEVICE=cuda:0
MAGE_MODEL_DTYPE=float16
MAGE_VIDEO_MEMORY_LIMIT=10g
MAGE_VIDEO_CPUS=4.0

# NVIDIA LocateAnything-3B runs the localization leg; Qwen remains the
# content/OCR leg. RETIRED: same as Mage-VL above. LocateAnything is released
# under NVIDIA's non-commercial research license.
NVIDIA_IMAGE_BASE_IMAGE=vllm/vllm-openai:v0.26.0
NVIDIA_IMAGE_MODEL_ID=nvidia/LocateAnything-3B
NVIDIA_IMAGE_PORT=30001
NVIDIA_IMAGE_MODEL_DEVICE=cuda:0
NVIDIA_IMAGE_MODEL_DTYPE=float16
NVIDIA_IMAGE_MEMORY_LIMIT=8g
NVIDIA_IMAGE_CPUS=4.0
QWEN_IMAGE=ollama/ollama:0.32.5
QWEN_BASE_URL=http://qwen-vision:11434
QWEN_MODEL_ID=qwen2.5vl:7b
# Keep the image model warm briefly for faster consecutive replies, then
# release it during idle periods to limit WSL/GPU pressure.
OLLAMA_KEEP_ALIVE=3m
# Set this to the existing local-vision_hermes-vision-model-cache volume only
# during migration; a new install uses the OpenClaw project volume by default.
QWEN_MODEL_CACHE_VOLUME=hermes-qq-openclaw_qwen-vision-model-cache
QWEN_MODEL_CACHE_EXTERNAL=false
QWEN_MEMORY_LIMIT=6g
QWEN_CPUS=2.0
