# OpenClaw and the official QQ/DDG plugins are pinned to verified stable
# releases; the core and plugin tracks use their own version numbers.
# The required names and supported legacy aliases are defined in environment-contract.txt.
OPENCLAW_IMAGE=ghcr.io/openclaw/openclaw:2026.8.2
OPENCLAW_QQBOT_PLUGIN=@tencent-connect/openclaw-qqbot@2.0.3

# The Control UI is published on host loopback only.
OPENCLAW_GATEWAY_PORT=18789
OPENCLAW_GATEWAY_TOKEN=replace-with-a-random-token
OPENCLAW_TZ=Asia/Shanghai

# macOS only: keep both services on loopback by default. To make the Mac
# reachable from a trusted LAN, bind to a concrete Mac LAN address. The helper
# can use OPS_CONSOLE_AUTH_MODE=none for redacted read-only LAN access; never
# use that mode with 0.0.0.0 or public port forwarding.
OPENCLAW_GATEWAY_BIND_HOST=127.0.0.1
OPENCLAW_GATEWAY_PUBLIC_HOST=127.0.0.1
OPS_CONSOLE_BIND_HOST=127.0.0.1
OPS_CONSOLE_PORT=18888
OPS_CONSOLE_AUTH_MODE=token
OPS_CONSOLE_TOKEN=replace-with-ops-console-token
SENSENOVA_VISION_MODEL=sensenova-6.7-flash-lite

# setup.sh replaces these with the current host UID/GID on Unix-like systems.
OPENCLAW_UID=1000
OPENCLAW_GID=1000

# QQ Open Platform credentials are filled by scripts/windows/Bind-OpenClawQQBot.bat
# through the one-time QR flow. DM and group mention access are open by default,
# so the allowlist OpenIDs and the proactive review home channel are optional.
QQBOT_APP_ID=replace-with-qq-app-id
QQBOT_CLIENT_SECRET=replace-with-qq-app-secret
QQBOT_ALLOWED_USER_OPENID=
QQBOT_ALLOWED_MEMBER_OPENID=
# Optional: keep false unless a low-frequency background group review is intentional.
QQBOT_PROACTIVE_REVIEW_ENABLED=false
QQBOT_HOME_CHANNEL=

# Use the official no-key DuckDuckGo plugin installed by the launcher.
SENSENOVA_API_KEY=replace-with-sensenova-api-key
DEEPSEEK_API_KEY=replace-with-deepseek-api-key

QWEN_IMAGE=ollama/ollama:0.32.5
QWEN_BASE_URL=http://qwen-vision:11434
QWEN_MODEL_ID=qwen2.5vl:7b
# Keep the image model warm briefly for faster consecutive replies, then
# release it during idle periods to limit WSL/GPU pressure.
OLLAMA_KEEP_ALIVE=3m
# A new install uses the OpenClaw project volume by default.
QWEN_MODEL_CACHE_VOLUME=qqshitbot-openclaw_qwen-vision-model-cache
QWEN_MODEL_CACHE_EXTERNAL=false
QWEN_MEMORY_LIMIT=6g
QWEN_CPUS=2.0
# Linux Codex overlay ASR defaults for an 8 GiB GPU.  Lower max-model-len or
# tune utilization only when deploying on hardware with a different VRAM size.
QWEN_ASR_GPU_MEMORY_UTILIZATION=0.75
QWEN_ASR_MAX_MODEL_LEN=2048

# Linux Codex overlay: the CPU-only game sidecar uses the existing local
# OpenAI-compatible Luna proxy.  Keep reasoning at max ("LunaMax"); the API
# key defaults to the local proxy marker and is not a QQ credential.
GAME_LLM_BASE_URL=http://127.0.0.1:18317/v1
GAME_LLM_API_KEY=local
GAME_LLM_MODEL=gpt-5.6-luna
GAME_LLM_REASONING_EFFORT=max
GAME_AI_GENERATION_TIMEOUT=45
GAME_LLM_GENERATE_MAX_TOKENS=256
GAME_LLM_JUDGE_MAX_TOKENS=256
# local starts immediately from the 50-puzzle catalog; use ai to enable
# bounded DuckDuckGo reference search plus LunaMax puzzle generation.
GAME_PUZZLE_SOURCE=local
# Keep local-puzzle rotation across qqbot-game/container restarts.
GAME_PUZZLE_SELECTION_STATE_PATH=/var/lib/qq-game/selection.json
# Keep an independent bounded rotation for each QQ group/conversation.
GAME_PUZZLE_SELECTION_MAX_GROUPS=2048
# Text-first games: no model call is needed for either game.  Each group or
# private conversation has at most one active game; active rounds live in RAM.
GAME_CHAT_CHAIN_MAX_ROUNDS=30
GAME_CHAT_WORDLE_MAX_GUESSES=10
GAME_CHAT_MAX_SESSIONS=2048
GAME_WEB_SEARCH_ENABLED=true
GAME_WEB_SEARCH_URL=https://html.duckduckgo.com/html/
QQBOT_GAME_SERVICE_URL=http://127.0.0.1:18104
QQBOT_GAME_CPUS=1.0
QQBOT_GAME_MEMORY_LIMIT=768m
